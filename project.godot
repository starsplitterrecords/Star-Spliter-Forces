; Engine configuration file.
; Input actions are registered at runtime by scripts/core/input_setup.gd so they
; can be remapped and validated in headless tests.

config_version=5

[application]

config/name="Star Splitter Forces"
config/description="An exploration-driven action roguelite set in the Star Splitter universe."
config/version="0.3.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.png"
boot_splash/bg_color=Color(0.031, 0.035, 0.078, 1)
boot_splash/show_image=false

[autoload]

Profile="*res://scripts/core/profile.gd"
Audio="*res://scripts/core/audio_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/Inter-Medium.otf"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.031, 0.035, 0.078, 1)
anti_aliasing/quality/msaa_2d=1
